{
  "vault_root": "/path/to/your/obsidian/vault",
  "index_path": "index.json",
  "logs_dir": "logs",
  "defaults": {
    "forum_id": null,
    "forum_tags": [],
    "guild_id": null,
    "limit": 1900,
    "buffer_policy": {
      "mode": "adaptive",
      "min": 2,
      "max": 10,
      "ratio": 0.5
    },
    "snapshot_attachment": true,
    "callout_mode": "quote",
    "wiki_link_mode": "discord",
    "wiki_link_style": "url",
    "wiki_link_fallback": "garden",
    "garden_base_url": "https://example.com",
    "image": {
      "max_bytes": 9500000,
      "max_width": 1600,
      "format": "preserve",
      "one_image_per_slot": true
    },
    "rate_limit": {
      "min_interval_ms": 350,
      "max_retries": 5
    }
  },
  "notes": {}
}
